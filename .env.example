# ==============================================================================
# Smart Order System - Environment Variables Example
# ==============================================================================
# ให้คัดลอกไฟล์นี้ไปไว้ที่ web/.env.local แล้วระบุค่าจริงจาก Supabase Dashboard
# cp .env.example web/.env.local

# 1. Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon / Publishable Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 3. Supabase Service Role Secret Key (สำหรับ Backend Admin & Server Actions เท่านั้น)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
