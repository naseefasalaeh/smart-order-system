# ==============================================================================
# Smart Order System - Environment Variables Example
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วระบุค่าจริงจาก Supabase Dashboard
# cp .env.example .env.local

# 1. Supabase Project URL (จาก Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon / Publishable Key (ใช้สำหรับ Frontend & Client-side)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# 3. Supabase Service Role Secret Key (สำหรับ Backend Admin & Server Actions เท่านั้น ห้ามเปิดเผยใน Client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 4. การตั้งค่าเสริม (Optional)
# PERF_LOG=1 # เปิดบันทึก Performance Log ใน console เมื่อพัฒนา
